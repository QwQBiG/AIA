# AI VTuber Digital Human - Environment Configuration
# 复制此文件为 .env 并填写实际值

# ===========================================
# Orchestrator 配置
# ===========================================
ORCHESTRATOR_PORT=3001
CORS_ENABLED=true

# ===========================================
# 数据库配置 (PostgreSQL + pgvector)
# ===========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=digital_human
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# ===========================================
# LLM 配置 (认知引擎)
# ===========================================
# 云端 LLM (选择一个)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# 本地 LLM
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2
KOBOLDCPP_ENDPOINT=http://localhost:5001

# ===========================================
# TTS 配置 (语音合成)
# ===========================================
# 云端 TTS
ELEVENLABS_API_KEY=your-elevenlabs-key
AZURE_TTS_API_KEY=your-azure-key
AZURE_TTS_REGION=eastus

# 本地 TTS
VITS_ENDPOINT=http://localhost:9880
GPT_SOVITS_ENDPOINT=http://localhost:9881

# ===========================================
# 视觉模块配置
# ===========================================
# 本地视觉模型端点 (LLaVA, MiniGPT-4)
VISION_ENDPOINT=http://localhost:8000

# ===========================================
# 嵌入模型配置 (记忆系统)
# ===========================================
# 本地嵌入模型端点
EMBEDDING_ENDPOINT=http://localhost:8001

# ===========================================
# 聊天平台配置
# ===========================================
# Twitch
TWITCH_USERNAME=your_bot_username
TWITCH_OAUTH_TOKEN=oauth:your_token
TWITCH_CHANNEL=your_channel

# YouTube
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_LIVE_CHAT_ID=your-live-chat-id
